% ===========================================================
% template.xmpdata -- PDF/A METADATA
% The name must match the main file (template.tex -> template.xmpdata)
%
% Fill in YOUR data. It must match Config/_cover.tex.
% Plain text only: do NOT use LaTeX commands such as \ncauthorname
% or \nctitle, do NOT use quotes, and separate items with \sep.
% ===========================================================

% Author: full name, as in \ncauthorname in Config/_cover.tex
% (several authors: \Author{Name One\sep Name Two})
\Author{Author Full Name}

% Title: the same title as \nctitle(main,...) in Config/_cover.tex
\Title{Title of the Dissertation or Project Report}

% Keywords: the same as in your abstract (at least 3)
\Keywords{keyword1\sep keyword2\sep keyword3}

% Subject: degree and course
\Subject{Dissertation submitted for the Master's degree in Computer Science and Computer Engineering}

% Publication type: bachelor thesis | master thesis
\PublicationType{master thesis}

% Language: en (English) | pt-PT (Portuguese) -- same as lang in Config/_options.tex
\Language{en}

% Copyright: year of submission and YOUR name
\CopyrightYear{2026}
\CopyrightOwner{Author Full Name}

% Institution (do not change)
\Publisher{Instituto Superior de Engenharia de Lisboa}
